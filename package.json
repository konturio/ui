{
  "name": "ui",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "workspaces": [
    "packages/*"
  ],
  "homepage": "https://konturio.github.io/ui",
  "scripts": {
    "build": "pnpm ts:clean && pnpm auto:ts:references && pnpm -r --filter=\"./packages/*\" pre-build && pnpm auto:ts:build && pnpm -r build",
    "build:watch": "pnpm auto:ts:references && pnpm -r --filter=\"./packages/*\" pre-build && pnpm auto:ts:build:watch && pnpm -r build",
    "dev": "pnpm -r --filter=\"./packages/*\" pre-start && pnpm auto:cosmos",
    "bootstrap": "pnpm -r install",
    "cosmos:build:export": "cosmos-export --config cosmos.config.export.json",
    "publish": "pnpm build && pnpm publish:packages",
    "publish:packages": "pnpm -r publish",
    "lint:fix": "eslint \"*/**/*.{ts,tsx}\" --fix",
    "lint-staged": "npx --no-install lint-staged --concurrent false",
    "release": "pnpm build && pnpm lint:fix && pnpm auto:lint && pnpm auto:typecheck && pnpm -r version",
    "release:push": "git push && git push origin --tags",
    "version:no-push": "pnpm -r version --no-git-tag-version",
    "ts:clean": "pnpm -r exec -- rimraf tslib && tsc --build --clean",
    "ts:watch": "tsc --build --watch",
    "auto:lint": "pnpm -r lint:fix && eslint \"*/**/*.{ts,tsx}\"",
    "auto:typecheck": "tsc --noEmit -p tsconfig.json",
    "auto:cosmos": "cosmos --config cosmos.config.json",
    "auto:ts:build": "tsc --build",
    "auto:ts:build:watch": "tsc --build --watch",
    "auto:ts:references": "node setup-references.mjs",
    "prettier": "prettier --write \"*/**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "prepare": "husky install"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "lint-staged": {
    "*/**/*.css": [
      "stylelint"
    ],
    "*/**/*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "prettier --write",
      "git add"
    ],
    "*/**/*.{ts,tsx}": [
      "pnpm lint:fix"
    ]
  },
  "resolutions": {
    "@turf/difference": "6.0.1"
  },
  "dependencies": {
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "clsx": "^2.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "dependency-cruiser": "^16.10.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-import-resolver-typescript": "^4.3.4",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^8.0.2",
    "lerna": "^4.0.0",
    "lint-staged": "^15.5.1",
    "parse5": "^7.3.0",
    "postcss": "^8.5.3",
    "postcss-cli": "^11.0.1",
    "postcss-csso": "^6.0.1",
    "postcss-import": "^16.1.0",
    "postcss-nested": "^7.0.2",
    "postcss-normalize": "^13.0.1",
    "prettier": "^3.5.3",
    "react-cosmos": "7.0.0-beta.2",
    "react-cosmos-plugin-vite": "7.0.0-beta.0",
    "rimraf": "^6.0.1",
    "stylelint": "^16.19.1",
    "stylelint-config-recommended": "^16.0.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.4",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "pnpm": {
    "patchedDependencies": {
      "vis-timeline@7.7.0": "./.pnpm-patches/vis-timeline@7.7.0.patch"
    }
  }
}
