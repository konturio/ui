{
  "useWorkspaces": true,
  "packages": ["packages/*"],
  "version": "independent",
  "npmClient": "pnpm",
  "command": {
    "version": {
      "allowBranch": "v5"
    },
    "publish": {
      "conventionalCommits": true
    },
    "bootstrap": {
      "npmClientArgs": ["--no-lockfile"]
    }
  }
}
